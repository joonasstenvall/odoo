<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Restrict component selector to MATERIAALI categories -->
        <record id="mrp_bom_form_view_inherit_kp_component_domain" model="ir.ui.view">
            <field name="name">mrp.bom.form.kp.component.domain</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="attributes">
                    <attribute name="domain">[("product_tmpl_id.categ_id.kp_category_type", "=", "MATERIAALI")]</attribute>
                    <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
                </xpath>
            </field>
        </record>

        <record id="mrp_bom_line_form_inherit_kp_component_domain" model="ir.ui.view">
            <field name="name">mrp.bom.line.form.kp.component.domain</field>
            <field name="model">mrp.bom.line</field>
            <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="attributes">
                    <attribute name="domain">[("product_tmpl_id.categ_id.kp_category_type", "=", "MATERIAALI")]</attribute>
                    <attribute name="options">{'no_quick_create': True, 'no_create_edit': True}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Restrict BoM parent product selector to NIMIKE categories -->
        <record id="mrp_bom_form_view_inherit_kp_parent_domain" model="ir.ui.view">
            <field name="name">mrp.bom.form.kp.parent.domain</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tmpl_id']" position="attributes">
                    <attribute name="domain">[("categ_id.kp_category_type", "=", "NIMIKE")]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
