<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_kp_test_item_list" model="ir.ui.view">
        <field name="name">kp.test.item.list</field>
        <field name="model">kp.test.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_kp_test_item_form" model="ir.ui.view">
        <field name="name">kp.test.item.form</field>
        <field name="model">kp.test.item</field>
        <field name="arch" type="xml">
            <form string="KP Test Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kp_test_items" model="ir.actions.act_window">
        <field name="name">KP Test Items</field>
        <field name="res_model">kp.test.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
